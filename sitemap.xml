---
layout: none
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- comment -%} Standard pages — skip non-HTML assets and excluded pages {%- endcomment -%}
  {%- for p in site.pages -%}
    {%- if p.sitemap == false or p.noindex == true -%}
      {%- continue -%}
    {%- endif -%}
    {%- unless p.url contains '.xml' or p.url contains '.txt' or p.url contains '.json' -%}
    <url>
      <loc>{{ site.url }}{{ p.url }}</loc>
      {%- if p.last_modified_at -%}
        <lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
      {%- elsif p.date -%}
        <lastmod>{{ p.date | date_to_xmlschema }}</lastmod>
      {%- endif -%}
      {%- if p.url == '/' -%}
      <changefreq>weekly</changefreq>
      <priority>1.0</priority>
      {%- else -%}
      <changefreq>monthly</changefreq>
      <priority>0.5</priority>
      {%- endif -%}
    </url>
    {%- endunless -%}
  {%- endfor -%}

  {%- comment -%} Collection: articles {%- endcomment -%}
  {%- for p in site.articles -%}
    {%- if p.sitemap == false or p.noindex == true -%}
      {%- continue -%}
    {%- endif -%}
    <url>
      <loc>{{ site.url }}{{ p.url }}</loc>
      {%- if p.last_modified_at -%}
        <lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
      {%- elsif p.date -%}
        <lastmod>{{ p.date | date_to_xmlschema }}</lastmod>
      {%- endif -%}
      <changefreq>monthly</changefreq>
      <priority>0.8</priority>
    </url>
  {%- endfor -%}
</urlset>
